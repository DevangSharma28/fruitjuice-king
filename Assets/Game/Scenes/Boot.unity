  group: {fileID: 1584069523}
  background: {fileID: 511847227}
  logo: {fileID: 1268361922}
  logoGroup: {fileID: 1268361918}
  logoShine: {fileID: 1534954604}
  barFill: {fileID: 1553239108}
  barFillGloss: {fileID: 1164553651}
